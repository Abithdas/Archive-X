{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Archive X",
  "version": "30.0.0",
  "identifier": "app.archivex.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Archive X",
        "url": "splash.html",
        "width": 1360,
        "height": 860,
        "minWidth": 360,
        "minHeight": 560,
        "center": true,
        "backgroundColor": "#232833"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Archive X",
    "shortDescription": "Your Telegram video library, as a desktop app",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../backend/dist/archive-x-backend": "backend",
      "resources/ffmpeg": "ffmpeg",
      "resources/rust": "rust",
      "resources/web": "web"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
