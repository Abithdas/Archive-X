# Python
.venv/
__pycache__/
*.pyc
# Node / frontend
node_modules/
# Rust / Tauri
target/
apps/desktop/src-tauri/target/
# Frozen backend build output
packaging/backend/build/
packaging/backend/dist/
apps/desktop/src-tauri/binaries/
# Local data / tooling output
graphify-out/
shots/
*.log
.archive-x-data/

# staged by .github/workflows/desktop.yml
apps/desktop/src-tauri/resources/rust/*
!apps/desktop/src-tauri/resources/rust/.gitkeep
apps/desktop/src-tauri/resources/web/*
!apps/desktop/src-tauri/resources/web/.gitkeep

# The web app's build output (made by npm run build; CI and the installer build it themselves)
apps/web/dist/
